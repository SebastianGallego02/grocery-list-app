# Repository-wide ignores. .NET rules live in backend/.gitignore, frontend rules in frontend/.gitignore.

# Environment files (secrets). Only .env.example is committed.
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors and IDEs
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs
*.log

# Archives (e.g. local zips of the project shared by hand)
*.zip
