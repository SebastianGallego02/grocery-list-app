# Copy to .env and set real values. .env is git-ignored.

# SQL Server SA password: at least 8 characters with uppercase, lowercase, digits and symbols.
# Avoid ';' because it is embedded in the API connection string.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Passw0rd

# HMAC key used to sign and validate JWTs: at least 32 characters.
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Host port for the API (http://localhost:<API_PORT>, Scalar UI at /scalar).
API_PORT=8080

# Host port for the web app (http://localhost:<WEB_PORT>). Also allowed by the API's CORS policy.
WEB_PORT=3000

# Extra origin allowed by CORS: the Vite dev server (npm run dev).
FRONTEND_ORIGIN=http://localhost:5173
