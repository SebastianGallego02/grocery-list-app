{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  // No secrets here. ConnectionStrings:GroceryListDb and Jwt:SigningKey come from
  // appsettings.Development.json (local dev only), user-secrets or environment variables.
  "Jwt": {
    "Issuer": "GroceryList.Api",
    "Audience": "GroceryList.Web",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
